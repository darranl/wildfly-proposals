source "https://rubygems.org"

gem "jekyll"
gem "minima"
# Ruby 4 no longer includes Logger among its default gems; Jekyll requires it.
gem "logger"
# Ruby 3.4+ no longer includes CSV among its default gems; Jekyll requires it.
gem "csv"
# Ruby 3.4+ no longer includes Base64 among its default gems; safe_yaml requires it.
gem "base64"

group :jekyll_plugins do
  gem "jekyll-feed"
  gem "jekyll-seo-tag"
  gem 'jekyll-asciidoc'
  gem 'jekyll-paginate-v2'

end
